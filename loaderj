-- ЛОГИКА ПОЛЕТА
local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude
local spinAngle = 0

RunService.RenderStepped:Connect(function(dt)
    local char = player.Character
    if not char or config.IsDead then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return end

    if config.TorpedoActive then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
        raycastParams.FilterDescendantsInstances = {char}

        local bestTarget = nil
        local bestScore = math.huge
        
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local tRoot = p.Character.HumanoidRootPart
                local dist = (root.Position - tRoot.Position).Magnitude
                local dirToTarget = (tRoot.Position - root.Position).Unit
                local checkHit = Workspace:Raycast(root.Position, dirToTarget * dist, raycastParams)
                
                local obstaclePenalty = checkHit and 40 or 0
                local totalScore = dist + obstaclePenalty
                
                if totalScore < bestScore then
                    bestScore = totalScore
                    bestTarget = tRoot
                end
            end
        end

        if bestTarget then
            local vector, onScreen = Camera:WorldToViewportPoint(bestTarget.Position)
            if onScreen then
                targetBox.Visible = true
                targetBox.Position = UDim2.new(0, vector.X - 35, 0, vector.Y - 35)
            else
                targetBox.Visible = false
            end
        else
            targetBox.Visible = false
        end

        if config.AttackLock then
            if bestTarget then
                local targetPos = bestTarget.Position + Vector3.new(0, 3, 0)
                local shortestDist = (root.Position - bestTarget.Position).Magnitude
                local moveDir = (targetPos - root.Position).Unit

                -- Если подлетели близко, отключаем обход препятствий, чтобы лететь строго в цель без дерганья
                if shortestDist > 10 then
                    local rayCenter = Workspace:Raycast(root.Position, moveDir * 18, raycastParams)
                    local rayLeft   = Workspace:Raycast(root.Position, (moveDir + root.CFrame.RightVector * 0.7).Unit * 14, raycastParams)
                    local rayRight  = Workspace:Raycast(root.Position, (moveDir - root.CFrame.RightVector * 0.7).Unit * 14, raycastParams)

                    if rayCenter then
                        if not rayLeft then
                            moveDir = (moveDir - root.CFrame.RightVector * 1.5 + Vector3.new(0, 0.8, 0)).Unit
                        elseif not rayRight then
                            moveDir = (moveDir + root.CFrame.RightVector * 1.5 + Vector3.new(0, 0.8, 0)).Unit
                        else
                            moveDir = (moveDir + Vector3.new(math.random(-1, 1), 2.0, math.random(-1, 1))).Unit
                        end
                    end
                end
                
                spinAngle = spinAngle + (dt * 5000)
                local lookCF = CFrame.lookAt(root.Position, root.Position + moveDir) * CFrame.Angles(0, math.rad(-90), math.rad(90))
                root.CFrame = lookCF * CFrame.Angles(0, 0, spinAngle)
                root.Velocity = moveDir * config.FlightSpeed

                Camera.CameraType = Enum.CameraType.Scriptable
                if head then
                    if config.CameraMode == 1 then
                        Camera.CFrame = CFrame.new(head.Position + (moveDir * 0.5) + Vector3.new(0, 0.5, 0), head.Position + moveDir * 10)
                    else
                        Camera.CFrame = CFrame.new(root.Position - (moveDir * 10) + Vector3.new(0, 6, 0), root.Position)
                    end
                end

                -- Увеличена дистанция детонации до 6 блоков, чтобы дрон гарантированно и сразу взрывался при подлете
                if shortestDist < 6.0 then
                    config.IsDead = true
                    config.AttackLock = false
                    config.TorpedoActive = false
                    targetBox.Visible = false
                    
                    staticFrame.Visible = true
                    staticFrame.BackgroundTransparency = 0
                    
                    hum.Health = 0
                    hum:TakeDamage(99999)
                    
                    for _, p in ipairs(char:GetDescendants()) do
                        if p:IsA("Motor6D") then
                            p:Destroy()
                        elseif p:IsA("BasePart") then
                            p.Velocity = moveDir * 140 + Vector3.new(math.random(-50,50), 90, math.random(-50,50))
                        end
                    end
                end
            else
                root.Velocity = Vector3.new(0, 0, 0)
            end
        else
            local camLook = Camera.CFrame.LookVector
            local flatLook = Vector3.new(camLook.X, 0, camLook.Z).Unit
            if flatLook.Magnitude > 0 then
                root.CFrame = CFrame.lookAt(root.Position, root.Position + flatLook) * CFrame.Angles(0, math.rad(-90), math.rad(90))
            end
            root.Velocity = Vector3.new(0, 0, 0)

            Camera.CameraType = Enum.CameraType.Scriptable
            if head then
                if config.CameraMode == 1 then
                    Camera.CFrame = CFrame.new(head.Position + Vector3.new(0, 1.0, 0), head.Position + flatLook * 10)
                else
                    Camera.CFrame = CFrame.new(root.Position - (flatLook * 8) + Vector3.new(0, 6, 0), root.Position)
                end
            end
        end
    else
        targetBox.Visible = false
    end
end)

